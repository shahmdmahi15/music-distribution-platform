generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PlatformUserRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  CLIENT
}

enum WhiteLabelUserRole {
  OWNER
  PARTNER
  ADMIN
  MANAGER
  STAFF
  CLIENT
}

enum OAuthAccountProvider {
  GOOGLE
  GITHUB
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  REFUNDED
  CANCELED
}

enum WhiteLabelBusinessType {
  RECORD_LABEL
  DISTRIBUTOR_AGGREGATOR
  MUSIC_PUBLISHER
  OTHER
}

enum WhiteLabelSignupModel {
  OPEN_PUBLIC
  INVITE_ONLY
  VETTED_APPLICATION
  MANUAL_APPROVAL
}

enum WhiteLabelStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

model OAuthAccount {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  code         String  @unique
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  idToken      String?
  scope        String?
  password     String?

  // Flags

  // Enums
  provider OAuthAccountProvider

  // Foreign Keys
  platformUserId   String?
  whiteLabelUserId String?

  // Parent Relations
  platformUser   PlatformUser?   @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  whiteLabelUser WhiteLabelUser? @relation(fields: [whiteLabelUserId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Constraints && Indexes
}

model Session {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  code         String  @unique
  token        String  @unique
  ipAddress    String?
  userAgent    String?
  revokeReason String?

  // Flags

  // Enums

  // Foreign Keys
  platformUserId   String?
  whiteLabelUserId String?

  // Parent Relations
  platformUser   PlatformUser?   @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  whiteLabelUser WhiteLabelUser? @relation(fields: [whiteLabelUserId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  accessedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Constraints && Indexes
}

model PlatformUser {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  code                        String  @unique
  firstName                   String
  lastName                    String
  email                       String  @unique
  passwordHash                String?
  image                       String?
  failedLoginAttempts         Int     @default(0)
  failedVerificationAttempts  Int     @default(0)
  failedPasswordResetAttempts Int     @default(0)
  failedTwoFactorAttempts     Int     @default(0)

  // Flags
  emailVerified    Boolean @default(false)
  twoFactorEnabled Boolean @default(false)

  // Enums
  role PlatformUserRole @default(CLIENT)

  // Foreign Keys

  // Parent Relations

  // Child Relations
  oAuthAccounts OAuthAccount[]
  sessions      Session[]
  subscription  PlatformSubscription?

  // Timestamps
  lastLoginAt DateTime?
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Constraints && Indexes
}

model PlatformSubscription {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  code String @unique

  // Flags

  // Enums

  // Foreign Keys
  subscriberId String @unique

  // Parent Relations
  subscriber PlatformUser @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  // Child Relations
  payments   PlatformSubscriptionPayment[]
  whiteLabel WhiteLabel?

  // Timestamps
  suspendedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Constraints && Indexes
}

model PlatformSubscriptionPayment {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  code     String        @unique
  amount   Int
  discount Int           @default(0)

  // Flags

  // Enums
  status PaymentStatus @default(PENDING)

  // Foreign Keys
  subscriptionId String

  // Parent Relations
  subscription PlatformSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints && Indexes
}

model WhiteLabel {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  code String @unique
  name String

  // Corporate Profile
  businessType         WhiteLabelBusinessType @default(RECORD_LABEL)
  companyWebsite       String?
  country              String?
  yearsInBusiness      Int                    @default(0)
  isIncorporated       Boolean                @default(false)
  incorporationDocUrl  String?

  // Identity & Branding
  subdomain            String?                @unique
  customDomain         String?                @unique
  tagline              String?
  description          String?
  logoUrl              String?
  logoDarkUrl          String?
  faviconUrl           String?
  bannerUrl            String?
  primaryColor         String?                @default("#6366f1")
  accentColor          String?                @default("#ec4899")
  supportEmail         String?
  supportPhone         String?
  copyrightText        String?
  socialInstagram      String?
  socialTwitter        String?
  socialYoutube        String?
  socialSpotify        String?
  socialFacebook       String?
  socialLinkedin       String?
  socialTiktok         String?

  // Contact Person
  contactFirstName     String?
  contactLastName      String?
  contactEmail         String?
  contactLinkedIn      String?

  // Catalog & Operational Telemetry
  catalogTrackCount       Int                    @default(0)
  monthlyTrackDelivery    Int                    @default(0)
  monthlyRevenueUsd       Decimal?               @db.Decimal(14, 2)
  hasDirectDeals          Boolean                @default(false)
  currentDistributors     String[]               @default([])
  royaltySolutions        String[]               @default([])
  primaryCatalogLanguage  String                 @default("en")
  wantsCatalogMigration   Boolean                @default(false)
  hasSampleBasedCovers    Boolean                @default(false)
  userSignupModel         WhiteLabelSignupModel  @default(INVITE_ONLY)

  // Compliance & Status Lifecycle
  privacyPolicyAccepted   Boolean                @default(true)
  marketingConsent        Boolean                @default(false)
  status                  WhiteLabelStatus       @default(PENDING)
  statusReason            String?
  approvedAt              DateTime?
  reviewedAt              DateTime?

  // Foreign Keys
  subscriptionId String @unique

  // Parent Relations
  subscription PlatformSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // Child Relations
  artists          WhiteLabelTopArtist[]
  documents        WhiteLabelDocument[]
  partners         WhiteLabelPartner[]
  users            WhiteLabelUser[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints && Indexes
}

model WhiteLabelTopArtist {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  code              String   @unique
  artistName        String
  instagramHandle   String?
  spotifyProfileUrl String?
  youtubeChannelUrl String?
  monthlyListeners  Int?
  orderIndex        Int      @default(1)

  // Foreign Keys
  whiteLabelId String

  // Parent Relations
  whiteLabel WhiteLabel @relation(fields: [whiteLabelId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints && Indexes
  @@index([whiteLabelId])
}

model WhiteLabelDocument {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  code          String   @unique
  type          String
  name          String
  fileKey       String
  mimeType      String?
  fileSizeBytes Int?

  // Foreign Keys
  whiteLabelId String

  // Parent Relations
  whiteLabel WhiteLabel @relation(fields: [whiteLabelId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints && Indexes
  @@index([whiteLabelId])
}

model WhiteLabelUser {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  code                        String  @unique
  firstName                   String
  lastName                    String
  email                       String
  passwordHash                String?
  image                       String?
  failedLoginAttempts         Int     @default(0)
  failedVerificationAttempts  Int     @default(0)
  failedPasswordResetAttempts Int     @default(0)
  failedTwoFactorAttempts     Int     @default(0)

  // Flags
  twoFactorEnabled Boolean @default(false)

  // Enums
  role WhiteLabelUserRole @default(CLIENT)

  // Foreign Keys
  whiteLabelId String

  // Parent Relations
  whiteLabel WhiteLabel @relation(fields: [whiteLabelId], references: [id], onDelete: Cascade)

  // Child Relations
  oAuthAccounts     OAuthAccount[]
  sessions          Session[]
  whiteLabelPartner WhiteLabelPartner?

  // Timestamps
  lastLoginAt DateTime?
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Constraints && Indexes
  @@unique([email, whiteLabelId])
}

model WhiteLabelPartner {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  code String @unique

  // Flags

  // Enums

  // Foreign Keys
  whiteLabelId String
  userId       String @unique

  // Parent Relations
  whiteLabel WhiteLabel     @relation(fields: [whiteLabelId], references: [id], onDelete: Cascade)
  user       WhiteLabelUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints && Indexes
}
