generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PlatformUserRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  CLIENT
}

enum WhiteLabelUserRole {
  OWNER
  PARTNER
  ADMIN
  MANAGER
  STAFF
  CLIENT
}

enum OAuthAccountProvider {
  GOOGLE
  GITHUB
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  REFUNDED
  CANCELED
}

enum WhiteLabelBusinessType {
  RECORD_LABEL
  DISTRIBUTOR_AGGREGATOR
  MUSIC_PUBLISHER
  REFERRER
}

enum WhiteLabelSignupModel {
  INVITE_ONLY
  ADMIN_APPROVAL
  OPEN_REGISTRATION
}

enum WhiteLabelStatus {
  PENDING
  UNDER_REVIEW
  PROCESSING
  REJECTED
  CONTRACTED
  PAID
  ACTIVE
  SUSPENDED
}

enum ProvisioningStatus {
  NOT_STARTED
  CREDENTIALS_VALIDATED
  STORAGE_PROVISIONED
  SES_CONFIGURED
  EC2_LAUNCHING
  DNS_CONFIGURED
  DEPLOYING_APPLICATION
  ACTIVE
  FAILED
}

model OAuthAccount {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  code         String  @unique
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  idToken      String?
  scope        String?
  password     String?

  // Flags

  // Enums
  provider OAuthAccountProvider

  // Foreign Keys
  platformUserId   String?
  whiteLabelUserId String?

  // Parent Relations
  platformUser   PlatformUser?   @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  whiteLabelUser WhiteLabelUser? @relation(fields: [whiteLabelUserId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Constraints && Indexes
}

model Session {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  code         String  @unique
  token        String  @unique
  ipAddress    String?
  userAgent    String?
  revokeReason String?

  // Flags

  // Enums

  // Foreign Keys
  platformUserId   String?
  whiteLabelUserId String?

  // Parent Relations
  platformUser   PlatformUser?   @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  whiteLabelUser WhiteLabelUser? @relation(fields: [whiteLabelUserId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  accessedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Constraints && Indexes
  // Supports the active-session lookups and counts filtered by owner + state.
  @@index([platformUserId, revokedAt])
  @@index([expiresAt])
}

model PlatformUser {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  code                        String  @unique
  firstName                   String
  lastName                    String
  email                       String  @unique
  passwordHash                String?
  image                       String?
  failedLoginAttempts         Int     @default(0)
  failedVerificationAttempts  Int     @default(0)
  failedPasswordResetAttempts Int     @default(0)
  failedTwoFactorAttempts     Int     @default(0)

  // Flags
  emailVerified    Boolean @default(false)
  twoFactorEnabled Boolean @default(false)

  // Enums
  role PlatformUserRole @default(CLIENT)

  // Foreign Keys

  // Parent Relations

  // Child Relations
  oAuthAccounts OAuthAccount[]
  sessions      Session[]
  subscription  PlatformSubscription?

  // Timestamps
  lastLoginAt DateTime?
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Constraints && Indexes
  // Backs the admin list filters and the stats aggregates.
  @@index([role])
  @@index([lockedUntil])
  @@index([emailVerified])
  @@index([twoFactorEnabled])
  @@index([createdAt])
}

model PlatformSubscription {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  code String @unique

  // Flags

  // Enums

  // Foreign Keys
  subscriberId String @unique

  // Parent Relations
  subscriber PlatformUser @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  // Child Relations
  payments   PlatformSubscriptionPayment[]
  whiteLabel WhiteLabel?

  // Timestamps
  suspendedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Constraints && Indexes
}

model PlatformSubscriptionPayment {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  code     String        @unique
  amount   Int
  discount Int           @default(0)

  // Flags

  // Enums
  status PaymentStatus @default(PENDING)

  // Foreign Keys
  subscriptionId String

  // Payment Details
  paymentMethod    String?  @default("OFFLINE_MANUAL")
  receiptReference String?
  adminNotes       String?

  // Parent Relations
  subscription PlatformSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints && Indexes
  // Backs the active/pending subscription payment lookups.
  @@index([subscriptionId, status, endsAt])
}

model WhiteLabel {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  code String @unique
  name String

  // Corporate Profile
  businessType         WhiteLabelBusinessType @default(RECORD_LABEL)
  companyWebsite       String?
  country              String?
  yearsInBusiness      Int                    @default(0)
  isIncorporated       Boolean                @default(false)
  incorporationDocUrl  String?

  // Identity & Branding
  subdomain               String?                @unique
  customDomain            String?                @unique
  domainVerificationToken String?
  domainVerified          Boolean                @default(false)
  domainVerifiedAt        DateTime?
  domainSslStatus         String?                @default("NOT_CONFIGURED")
  elasticIpv4             String?
  tagline                 String?
  description             String?
  logoUrl                 String?
  logoDarkUrl             String?
  faviconUrl              String?
  bannerUrl               String?
  primaryColor            String?                @default("#6366f1")
  accentColor             String?                @default("#ec4899")
  themeRadius             String?                @default("0.5rem")
  themeFont               String?                @default("Inter")
  themeMode               String?                @default("dark")
  navbarStyle             String?                @default("glass")
  cardStyle               String?                @default("modern")
  supportEmail            String?
  supportPhone            String?
  copyrightText           String?
  socialInstagram         String?
  socialTwitter           String?
  socialYoutube           String?
  socialSpotify           String?
  socialFacebook          String?
  socialLinkedin          String?
  socialTiktok            String?

  // SSO & Security Configuration
  ssoGoogleEnabled        Boolean                @default(true)
  ssoGithubEnabled        Boolean                @default(false)
  ssoEnforce2fa           Boolean                @default(false)
  ssoSessionTimeoutHours  Int                    @default(72)

  // Dedicated Cloud & Infrastructure Credentials
  awsRegion               String?
  awsAccessKeyId          String?
  awsSecretAccessKey      String?
  bucketName              String?
  senderEmail             String?
  databaseUrl             String?
  redisUrl                String?
  cloudflareApiToken      String?
  cloudflareZoneId        String?
  cloudflareBaseDomain    String?

  // AWS Multi-Cloud Infrastructure & Telemetry
  awsInstanceId           String?
  awsElasticIp            String?
  awsAllocationId         String?
  awsSecurityGroupId      String?
  awsInstanceType         String?                @default("t4g.medium")
  awsInstanceState        String?                @default("STOPPED")

  // Storage & SES Telemetry
  s3BucketArn             String?
  s3CorsConfigured        Boolean                @default(false)
  sesIdentityStatus       String?                @default("PENDING")
  sesDkimTokens           String[]               @default([])

  // Provisioning Lifecycle & Live Telemetry
  provisioningStatus      ProvisioningStatus     @default(NOT_STARTED)
  provisioningProgress    Int                    @default(0)
  provisioningStep        String?
  provisioningLogs        Json?
  provisionedAt           DateTime?
  provisioningError       String?

  // Contact Person
  contactFirstName        String?
  contactLastName         String?
  contactEmail            String?
  contactLinkedIn         String?

  // Catalog & Operational Telemetry
  catalogTrackCount       Int                    @default(0)
  monthlyTrackDelivery    Int                    @default(0)
  monthlyRevenueUsd       Decimal?               @db.Decimal(14, 2)
  hasDirectDeals          Boolean                @default(false)
  currentDistributors     String[]               @default([])
  royaltySolutions        String[]               @default([])
  primaryCatalogLanguage  String                 @default("en")
  wantsCatalogMigration   Boolean                @default(false)
  hasSampleBasedCovers    Boolean                @default(false)
  userSignupModel         WhiteLabelSignupModel  @default(INVITE_ONLY)
  onboardingDetails       Json?

  // Compliance & Status Lifecycle
  privacyPolicyAccepted   Boolean                @default(true)
  marketingConsent        Boolean                @default(false)
  isSetupComplete         Boolean                @default(false)
  status                  WhiteLabelStatus       @default(PENDING)
  statusReason            String?
  approvedAt              DateTime?
  reviewedAt              DateTime?

  // Contract Information
  contractKey             String?
  contractFileName        String?
  contractFileSize        Int?
  contractUploadedAt      DateTime?
  contractUploadedBy      String?

  // Foreign Keys
  subscriptionId String @unique

  // Parent Relations
  subscription PlatformSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // Child Relations
  artists          WhiteLabelTopArtist[]
  documents        WhiteLabelDocument[]
  partners         WhiteLabelPartner[]
  users            WhiteLabelUser[]
  apiKeys          WhiteLabelApiKey[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints && Indexes
  // Backs the admin list filters and the status-count aggregate.
  @@index([status])
  @@index([businessType])
  @@index([createdAt])
}

model WhiteLabelTopArtist {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  code              String   @unique
  artistName        String
  instagramHandle   String?
  spotifyProfileUrl String?
  youtubeChannelUrl String?
  monthlyListeners  Int?
  orderIndex        Int      @default(1)

  // Foreign Keys
  whiteLabelId String

  // Parent Relations
  whiteLabel WhiteLabel @relation(fields: [whiteLabelId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints && Indexes
  @@index([whiteLabelId])
}

model WhiteLabelDocument {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  code          String   @unique
  type          String
  name          String
  fileKey       String
  mimeType      String?
  fileSizeBytes Int?

  // Foreign Keys
  whiteLabelId String

  // Parent Relations
  whiteLabel WhiteLabel @relation(fields: [whiteLabelId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints && Indexes
  @@index([whiteLabelId])
}

model WhiteLabelUser {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  code                        String  @unique
  firstName                   String
  lastName                    String
  email                       String
  passwordHash                String?
  image                       String?
  failedLoginAttempts         Int     @default(0)
  failedVerificationAttempts  Int     @default(0)
  failedPasswordResetAttempts Int     @default(0)
  failedTwoFactorAttempts     Int     @default(0)

  // Flags
  twoFactorEnabled Boolean @default(false)
  isApproved       Boolean @default(true)

  // Enums
  role WhiteLabelUserRole @default(CLIENT)

  // Foreign Keys
  whiteLabelId String

  // Parent Relations
  whiteLabel WhiteLabel @relation(fields: [whiteLabelId], references: [id], onDelete: Cascade)

  // Child Relations
  oAuthAccounts     OAuthAccount[]
  sessions          Session[]
  whiteLabelPartner WhiteLabelPartner?

  // Timestamps
  lastLoginAt DateTime?
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Constraints && Indexes
  @@unique([email, whiteLabelId])
}

model WhiteLabelPartner {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  code String @unique

  // Flags

  // Enums

  // Foreign Keys
  whiteLabelId String
  userId       String @unique

  // Parent Relations
  whiteLabel WhiteLabel     @relation(fields: [whiteLabelId], references: [id], onDelete: Cascade)
  user       WhiteLabelUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints && Indexes
}

model WhiteLabelApiKey {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  code       String    @unique
  name       String
  keyHash    String    @unique
  keyPrefix  String
  keyMasked  String
  scopes     String[]  @default(["*"])

  // Telemetry
  lastUsedAt DateTime?
  expiresAt  DateTime?

  // Flags
  isActive   Boolean   @default(true)

  // Foreign Keys
  whiteLabelId String

  // Parent Relations
  whiteLabel WhiteLabel @relation(fields: [whiteLabelId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints && Indexes
  @@index([whiteLabelId, isActive])
  @@index([keyHash])
}
