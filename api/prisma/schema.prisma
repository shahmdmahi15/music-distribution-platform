generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PlatformUserRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
}

enum WhitelabelUserRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  MEMBER
  CUSTOMER
}

enum OAuthAccountProvider {
  GOOGLE
  GITHUB
}

model PlatformUser {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  firstName                   String
  lastName                    String
  email                       String  @unique
  passwordHash                String?
  failedLoginAttempts         Int     @default(0)
  failedVerificationAttempts  Int     @default(0)
  failedPasswordResetAttempts Int     @default(0)
  failedTwoFactorAttempts     Int     @default(0)

  // Flags
  emailVerified    Boolean @default(false)
  twoFactorEnabled Boolean @default(false)

  // Enums
  role PlatformUserRole @default(CUSTOMER)

  // Foreign Keys

  // Parent Relations

  // Child Relations
  oAuthAccounts OAuthAccount[]
  sessions      Session[]

  // Timestamps
  lastLoginAt DateTime?
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Constraints && Indexes
}

model WhitelabelUser {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  firstName                   String
  lastName                    String
  email                       String  @unique
  passwordHash                String?
  failedLoginAttempts         Int     @default(0)
  failedVerificationAttempts  Int     @default(0)
  failedPasswordResetAttempts Int     @default(0)
  failedTwoFactorAttempts     Int     @default(0)

  // Flags
  twoFactorEnabled Boolean @default(false)

  // Enums
  role WhitelabelUserRole @default(CUSTOMER)

  // Foreign Keys

  // Parent Relations

  // Child Relations
  oAuthAccounts OAuthAccount[]
  sessions      Session[]

  // Timestamps
  lastLoginAt DateTime?
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Constraints && Indexes
}

model OAuthAccount {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  idToken      String?
  scope        String?
  password     String?

  // Flags

  // Enums
  provider OAuthAccountProvider

  // Foreign Keys
  platformUserId   String?
  whitelabelUserId String?

  // Parent Relations
  platformUser   PlatformUser?   @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  whitelabelUser WhitelabelUser? @relation(fields: [whitelabelUserId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Constraints && Indexes
}

model Session {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  token        String  @unique
  ipAddress    String?
  userAgent    String?
  revokeReason String?

  // Flags

  // Enums

  // Foreign Keys
  platformUserId   String?
  whitelabelUserId String?

  // Parent Relations
  platformUser   PlatformUser?   @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  whitelabelUser WhitelabelUser? @relation(fields: [whitelabelUserId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  accessedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Constraints && Indexes
}

