generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PlatformUserRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  CLIENT
}

enum WhiteLabelUserRole {
  OWNER
  PARTNER
  ADMIN
  MANAGER
  STAFF
  CLIENT
}

enum WorkspaceAccessRole {
  OWNER
  PARTNER
  ADMIN
  MANAGER
  STAFF
  CLIENT
}

enum OAuthAccountProvider {
  GOOGLE
  GITHUB
}

model OAuthAccount {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  idToken      String?
  scope        String?
  password     String?

  // Flags

  // Enums
  provider OAuthAccountProvider

  // Foreign Keys
  platformUserId   String?
  whiteLabelUserId String?

  // Parent Relations
  platformUser   PlatformUser?   @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  whiteLabelUser WhiteLabelUser? @relation(fields: [whiteLabelUserId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Constraints && Indexes
}

model Session {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  token        String  @unique
  ipAddress    String?
  userAgent    String?
  revokeReason String?

  // Flags

  // Enums

  // Foreign Keys
  platformUserId   String?
  whiteLabelUserId String?

  // Parent Relations
  platformUser   PlatformUser?   @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  whiteLabelUser WhiteLabelUser? @relation(fields: [whiteLabelUserId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  accessedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Constraints && Indexes
}

model PlatformUser {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  firstName                   String
  lastName                    String
  email                       String  @unique
  passwordHash                String?
  failedLoginAttempts         Int     @default(0)
  failedVerificationAttempts  Int     @default(0)
  failedPasswordResetAttempts Int     @default(0)
  failedTwoFactorAttempts     Int     @default(0)

  // Flags
  emailVerified    Boolean @default(false)
  twoFactorEnabled Boolean @default(false)

  // Enums
  role PlatformUserRole @default(CLIENT)

  // Foreign Keys

  // Parent Relations

  // Child Relations
  oAuthAccounts OAuthAccount[]
  sessions      Session[]
  whiteLabel    WhiteLabel?

  // Timestamps
  lastLoginAt DateTime?
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Constraints && Indexes
}

model WhiteLabel {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  name String

  // Flags

  // Enums

  // Foreign Keys
  ownerId String @unique

  // Parent Relations
  owner PlatformUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Child Relations
  whiteLabelConfig WhiteLabelConfig?
  domain           WhiteLabelDomain?
  partners         WhiteLabelPartner[]
  users            WhiteLabelUser[]
  workspaces       Workspace[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints && Indexes
}

model WhiteLabelConfig {
  // Primary key
  id String @id @default(cuid())

  // Data Fields

  // Flags

  // Enums

  // Foreign Keys
  whiteLabelId String @unique

  // Parent Relations
  whiteLabel WhiteLabel @relation(fields: [whiteLabelId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints && Indexes
}

model WhiteLabelDomain {
  // Primary key
  id String @id @default(cuid())

  // Data Fields

  // Flags

  // Enums

  // Foreign Keys
  whiteLabelId String @unique

  // Parent Relations
  whiteLabel WhiteLabel @relation(fields: [whiteLabelId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints && Indexes
}

model WhiteLabelUser {
  // Primary key
  id String @id @default(cuid())

  // Data Fields
  firstName                   String
  lastName                    String
  email                       String
  passwordHash                String?
  failedLoginAttempts         Int     @default(0)
  failedVerificationAttempts  Int     @default(0)
  failedPasswordResetAttempts Int     @default(0)
  failedTwoFactorAttempts     Int     @default(0)

  // Flags
  twoFactorEnabled Boolean @default(false)

  // Enums
  role WhiteLabelUserRole @default(CLIENT)

  // Foreign Keys
  whiteLabelId String

  // Parent Relations
  whiteLabel WhiteLabel @relation(fields: [whiteLabelId], references: [id], onDelete: Cascade)

  // Child Relations
  oAuthAccounts     OAuthAccount[]
  sessions          Session[]
  whiteLabelPartner WhiteLabelPartner?
  workspaces        Workspace[]
  workspacePartner  WorkspacePartner?
  workspacesAccess  WorkspaceAccess[]

  // Timestamps
  lastLoginAt DateTime?
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Constraints && Indexes
  @@unique([email, whiteLabelId])
}

model WhiteLabelPartner {
  // Primary key
  id String @id @default(cuid())

  // Data Fields

  // Flags

  // Enums

  // Foreign Keys
  whiteLabelId String
  userId       String @unique

  // Parent Relations
  whiteLabel WhiteLabel     @relation(fields: [whiteLabelId], references: [id], onDelete: Cascade)
  user       WhiteLabelUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints && Indexes
}

model Workspace {
  // Primary key
  id String @id @default(cuid())

  // Data Fields

  // Flags

  // Enums

  // Foreign Keys
  whiteLabelId String
  ownerId      String

  // Parent Relations
  whiteLabel WhiteLabel     @relation(fields: [whiteLabelId], references: [id], onDelete: Cascade)
  owner      WhiteLabelUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Child Relations
  partners WorkspacePartner[]
  access   WorkspaceAccess[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints && Indexes
}

model WorkspacePartner {
  // Primary key
  id String @id @default(cuid())

  // Data Fields

  // Flags

  // Enums

  // Foreign Keys
  workspaceId String
  userId      String @unique

  // Parent Relations
  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      WhiteLabelUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints && Indexes
}

model WorkspaceAccess {
  // Primary key
  id String @id @default(cuid())

  // Data Fields

  // Flags

  // Enums
  role WorkspaceAccessRole @default(CLIENT)

  // Foreign Keys
  workspaceId String
  userId      String

  // Parent Relations
  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      WhiteLabelUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints && Indexes
}

