<html>
  <head>
    <meta charset='utf-8' />
    <title>Verify Your Email</title>
    <style>
      body {
        font-family: sans-serif;
        padding: 20px;
        line-height: 1.5;
        color: #333;
      }
      .wrapper {
        max-width: 600px;
        margin: 0 auto;
        border: 1px solid #ddd;
        padding: 20px;
        border-radius: 4px;
      }
      .btn {
        display: inline-block;
        background-color: #0070f3;
        color: white !important;
        padding: 10px 20px;
        text-decoration: none;
        border-radius: 4px;
        margin-top: 10px;
      }
    </style>
  </head>
  <body>
    <div class='wrapper'>
      <h2>Hello {{{name}}},</h2>
      <p>Thank you for registering. Please confirm your email address by
        clicking the link below:</p>
      <p>
        <a ses:no-track class='btn' href='{{{url}}}' target='_blank'>Verify Email Address</a>
      </p>
      <p>If the button doesn't work, copy and paste this link into your browser:</p>
      <p ses:no-track style='word-break: break-all; color: #666;'>{{{url}}}</p>
    </div>
  </body>
</html>