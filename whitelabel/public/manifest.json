{
  "id": "/?source=pwa",
  "name": "Backstage Music Portal",
  "short_name": "Backstage",
  "description": "Artist and Record Label Distribution Backstage Portal",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "background_color": "#030712",
  "theme_color": "#4f46e5",
  "orientation": "any",
  "lang": "en-US",
  "dir": "ltr",
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "categories": ["music", "entertainment", "business"],
  "icons": [
    {
      "src": "/favicon-16x16.png",
      "sizes": "16x16",
      "type": "image/png"
    },
    {
      "src": "/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "New Release",
      "short_name": "New Release",
      "description": "Create and distribute a new music release",
      "url": "/releases/new",
      "icons": [{ "src": "/icon.svg", "sizes": "96x96" }]
    },
    {
      "name": "Catalog",
      "short_name": "Catalog",
      "description": "Manage tracks, albums and releases",
      "url": "/releases",
      "icons": [{ "src": "/icon.svg", "sizes": "96x96" }]
    },
    {
      "name": "VEVO Channels",
      "short_name": "VEVO",
      "description": "Manage official music video channels",
      "url": "/channels",
      "icons": [{ "src": "/icon.svg", "sizes": "96x96" }]
    },
    {
      "name": "Royalty Statements",
      "short_name": "Statements",
      "description": "View monthly earnings and payout statements",
      "url": "/reports",
      "icons": [{ "src": "/icon.svg", "sizes": "96x96" }]
    }
  ]
}
